{
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm db:types)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm exec vitest *)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./supabase/.env)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push *--no-verify*)",
      "Bash(*HUSKY=0*)",
      "Bash(git *core.hooksPath*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/biome-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
