# Copy to .env.local (gitignored). Values come from your Neon dev branch in the
# Neon Console: Connect (connection strings) and Auth (Neon Auth URL).
# On Vercel, the Neon integration sets these per deployment.

# Pooled connection string, used by the app.
DATABASE_URL=
# Direct connection string, used by `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=

NEON_AUTH_BASE_URL=
# Signs the session cookies. At least 32 characters: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
