# Copy to supabase/.env (gitignored). The Supabase CLI reads it on
# `pnpm db:start` and substitutes env(...) values in config.toml.
# Restart with `pnpm db:stop && pnpm db:start` after changing it.

# GitHub OAuth for local sign-in. Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
